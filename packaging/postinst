#!/var/jb/bin/sh
PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:$PATH
LD=/var/jb/Library/LaunchDaemons

mkdir -p /var/mobile/Library/WiFiTether
chown 501:501 /var/mobile/Library/WiFiTether

# A fresh install (not an update: then dpkg passes the old version as $2)
# shows the app's welcome screen again. Its answer is kept in the settings
# folder, which removing the app leaves behind.
if [ "$1" = "configure" ] && [ -z "$2" ]; then
    rm -f /var/mobile/Library/WiFiTether/setup-done
fi

# Share Wi-Fi over USB is off until it's switched on in the app (since 1.7).
# Before 1.7 it was on unless switched off, so someone updating from then who
# never touched it has been using it: keep it on for them.
if [ "$1" = "configure" ] && [ -n "$2" ] && [ ! -e /var/mobile/Library/WiFiTether/enabled ] &&
   dpkg --compare-versions "$2" lt "1.7~"; then
    echo 1 > /var/mobile/Library/WiFiTether/enabled
    chown 501:501 /var/mobile/Library/WiFiTether/enabled
fi

uicache -p /var/jb/Applications/WiFiTether.app >/dev/null 2>&1 || true

# WiFi Tether needs the Share tweak. With Sileo, the app's "Add Share's Repo in
# Sileo" button adds Share's repo through Sileo itself; the installer doesn't touch
# Sileo's list (Sileo rewrites it from memory while it installs, losing changes).
# Without Sileo, add the repo as a file of its own if it isn't there yet.
SRC=/var/jb/etc/apt/sources.list.d
OWN="$SRC/share-aminerostane.sources"
if [ -d /var/jb/Applications/Sileo.app ] || [ -f "$SRC/sileo.sources" ]; then
    rm -f "$OWN"   # left by 0.4.3 and 0.4.4; Sileo can't manage it
elif ! grep -rqs "aminerostane.com/repo" "$SRC" /var/jb/etc/apt/sources.list; then
    mkdir -p "$SRC"
    printf 'Types: deb\nURIs: https://aminerostane.com/repo/\nSuites: ./\nComponents:\n' > "$OWN"
    echo "Added the Share tweak's repo (aminerostane.com/repo)."
fi

# The upstream VPN tool (com.mali.pftun) does the same job; two copies would fight.
if [ -f $LD/com.mali.pftun.plist ]; then
    echo "Note: com.mali.pftun (ios-hotspot-vpn-keepalive) is installed. WiFi Tether includes it; stopping the separate copy."
    launchctl unload -w $LD/com.mali.pftun.plist >/dev/null 2>&1 || true
fi

for n in com.wifitether.daemon com.wifitether.vpn; do
    launchctl unload "$LD/$n.plist" >/dev/null 2>&1 || true
    launchctl load -w "$LD/$n.plist" || true
done

# The band switches' hand-over add-on loads when iOS's Wi-Fi service starts, so
# restart the service (Wi-Fi drops for a few seconds while it restarts).
if [ -f /var/jb/Library/MobileSubstrate/DynamicLibraries/WiFiTetherRoam.dylib ]; then
    echo "Restarting iOS's Wi-Fi service so the band switches' hand-over add-on loads (Wi-Fi drops for a few seconds)."
    killall -9 wifid >/dev/null 2>&1 || true
fi

# The Wi-Fi icon add-on (src/bar) and the Personal Hotspot indicator load
# when SpringBoard and the apps start, so respring.
#   - Installed by a package manager (Sileo, Zebra, Cydia: apt runs dpkg):
#     it shows its own Respring button (asked for here too), and respringing
#     now could cut it off mid-install, so leave it to that button.
#   - Installed by opening the .deb (Filza) or with plain dpkg: respring by
#     itself, a few seconds after the install finishes.
MANAGED=0
if [ -n "$CYDIA" ] || [ -n "$SILEO" ] || [ -n "$DPKG_FRONTEND_LOCKED" ]; then MANAGED=1; fi
if [ $MANAGED = 0 ] && command -v ps >/dev/null 2>&1; then
    pid=$PPID
    while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
        case "$(ps -o comm= -p "$pid" 2>/dev/null)" in
            *apt*|*Sileo*|*Zebra*|*Cydia*) MANAGED=1; break ;;
        esac
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    done
fi
if [ -n "$CYDIA" ]; then
    eval "echo 'finish:restart' >&${CYDIA%% *}" 2>/dev/null || true
fi
if [ $MANAGED = 1 ]; then
    echo "Respring once so the Wi-Fi icon and the Personal Hotspot indicator load."
else
    echo "Respringing in a few seconds so the Wi-Fi icon and the Personal Hotspot indicator load."
    nohup sh -c 'sleep 3; sbreload || killall -9 SpringBoard' </dev/null >/dev/null 2>&1 &
fi

exit 0
