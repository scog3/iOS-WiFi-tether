#!/var/jb/bin/sh
PATH=/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:$PATH
LD=/var/jb/Library/LaunchDaemons

mkdir -p /var/mobile/Library/WiFiTether
chown 501:501 /var/mobile/Library/WiFiTether

uicache -p /var/jb/Applications/WiFiTether.app >/dev/null 2>&1 || true

# WiFi Tether needs the Share tweak. With Sileo, the app's "Add Share's Repo in
# Sileo" button adds Share's repo through Sileo itself; the installer doesn't touch
# Sileo's list (Sileo rewrites it from memory while it installs, losing changes).
# Without Sileo, add the repo as a file of its own if it isn't there yet.
SRC=/var/jb/etc/apt/sources.list.d
OWN="$SRC/share-aminerostane.sources"
if [ -d /var/jb/Applications/Sileo.app ] || [ -f "$SRC/sileo.sources" ]; then
    rm -f "$OWN"   # left by 0.4.3 and 0.4.4; Sileo can't manage it
elif ! grep -rqs "aminerostane.com/repo" "$SRC" /var/jb/etc/apt/sources.list; then
    mkdir -p "$SRC"
    printf 'Types: deb\nURIs: https://aminerostane.com/repo/\nSuites: ./\nComponents:\n' > "$OWN"
    echo "Added the Share tweak's repo (aminerostane.com/repo)."
fi

# The upstream VPN tool (com.mali.pftun) does the same job; two copies would fight.
if [ -f $LD/com.mali.pftun.plist ]; then
    echo "Note: com.mali.pftun (ios-hotspot-vpn-keepalive) is installed. WiFi Tether includes it; stopping the separate copy."
    launchctl unload -w $LD/com.mali.pftun.plist >/dev/null 2>&1 || true
fi

for n in com.wifitether.daemon com.wifitether.vpn; do
    launchctl unload "$LD/$n.plist" >/dev/null 2>&1 || true
    launchctl load -w "$LD/$n.plist" || true
done

exit 0
